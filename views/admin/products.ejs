<%- include('../partials/header') %>

<div class="space-y-5">

  <!-- Header Action Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h3 class="text-lg lg:text-xl font-bold text-slate-900 dark:text-white tracking-tight">Katalog Produk & Margin</h3>
      <p class="text-xs text-slate-500">Kelola price-list Digiflazz, margin keuntungan server, dan aktivasi SKU.</p>
    </div>
    <form action="/admin/products/sync" method="POST" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerHTML='Menyinkronkan...';">
      <button type="submit" class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-0 text-xs font-semibold gap-1.5 shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        <span>Sinkronisasi Digiflazz</span>
      </button>
    </form>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
    <form action="/admin/products" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <div>
        <input type="text" name="q" value="<%= filter.q || '' %>" placeholder="Cari SKU, nama produk, brand..." class="input-fintech w-full" />
      </div>

      <div>
        <select name="category" class="input-fintech w-full">
          <option value="">Semua Kategori</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.category %>" <%= filter.category === c.category ? 'selected' : '' %>><%= c.category %> (<%= c.product_count %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <select name="status" class="input-fintech w-full">
          <option value="active" <%= filter.status === 'active' || !filter.status ? 'selected' : '' %>>Produk Aktif Saja</option>
          <option value="inactive" <%= filter.status === 'inactive' ? 'selected' : '' %>>Produk Nonaktif Saja</option>
          <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Semua Status</option>
        </select>
      </div>

      <div class="flex gap-2">
        <button type="submit" class="btn btn-sm bg-slate-900 hover:bg-slate-800 text-white border-0 flex-1 text-xs">Filter</button>
        <a href="/admin/products" class="btn btn-sm btn-ghost text-xs">Reset</a>
      </div>
    </form>
  </div>

  <!-- Products Table (Horizontal Touch-Scroll) -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="fintech-table">
        <thead>
          <tr>
            <th>SKU</th>
            <th>Nama Produk</th>
            <th>Kategori</th>
            <th>Brand</th>
            <th>Modal H2H</th>
            <th>Margin (+Rp)</th>
            <th>Harga Jual Agen</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <tr>
                <td>
                  <button type="button" onclick="copyToClipboard('<%= p.sku %>', 'SKU')" class="btn-copy" title="Salin SKU">
                    <span><%= p.sku %></span>
                    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
                  </button>
                </td>
                <td>
                  <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 max-w-[220px] truncate" title="<%= p.product_name %>">
                    <%= p.product_name %>
                  </div>
                  <% if (p.description) { %>
                    <p class="text-[10px] text-slate-400 truncate max-w-[220px]"><%= p.description %></p>
                  <% } %>
                </td>
                <td>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    <%= p.category %>
                  </span>
                </td>
                <td class="text-xs text-slate-500"><%= p.brand || '-' %></td>
                <td class="font-mono text-xs text-slate-600 dark:text-slate-300"><%= formatRupiah(p.price_modal) %></td>
                
                <!-- Inline Markup Form -->
                <td>
                  <form action="/admin/products/<%= p.sku %>/markup" method="POST" class="flex items-center gap-1.5">
                    <input type="number" name="markup" value="<%= p.markup || 0 %>" class="input-fintech w-20 text-right py-1 px-2 text-xs" />
                    <button type="submit" class="p-1 rounded-md text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20" title="Simpan Margin">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </button>
                  </form>
                </td>

                <td class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400">
                  <%= formatRupiah(p.price_sell) %>
                </td>
                
                <td>
                  <% if (p.is_active) { %>
                    <span class="badge-status badge-status-success">
                      <span class="dot-pulse dot-pulse-success"></span> Aktif
                    </span>
                  <% } else { %>
                    <span class="badge-status badge-status-failed">
                      <span class="dot-pulse dot-pulse-failed"></span> Nonaktif
                    </span>
                  <% } %>
                </td>

                <td class="text-right">
                  <form action="/admin/products/<%= p.sku %>/toggle" method="POST" class="inline">
                    <input type="hidden" name="is_active" value="<%= p.is_active ? '0' : '1' %>" />
                    <button type="submit" class="btn btn-xs <%= p.is_active ? 'btn-ghost text-red-500 hover:bg-red-50' : 'btn-ghost text-emerald-600 hover:bg-emerald-50' %> font-semibold text-[11px]">
                      <%= p.is_active ? 'Matikan' : 'Aktifkan' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-10 text-xs text-slate-400">
                Belum ada produk. Silakan klik tombol "Sinkronisasi Digiflazz".
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="p-3.5 border-t border-slate-100 dark:border-slate-800 flex justify-center">
        <div class="join">
          <% for(let i = 1; i <= pagination.totalPages; i++) { %>
            <a href="/admin/products?page=<%= i %>&q=<%= filter.q || '' %>&category=<%= filter.category || '' %>&status=<%= filter.status || '' %>"
               class="join-item btn btn-xs <%= pagination.page === i ? 'btn-active bg-blue-600 text-white border-0' : 'btn-ghost' %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
