<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto space-y-5">

  <div>
    <h3 class="text-lg lg:text-xl font-bold text-slate-900 dark:text-white tracking-tight">Pengaturan Sistem & Integrasi</h3>
    <p class="text-xs text-slate-500">Konfigurasi nama server, kredensial Digiflazz, WhatsApp bot Baileys, dan ganti password administrator.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    
    <!-- Main Settings Form (2 Cols) -->
    <div class="lg:col-span-2 space-y-5">
      
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 lg:p-6 shadow-sm space-y-4">
        <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Informasi Brand & Server</h4>
        
        <form action="/admin/settings" method="POST" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Nama Brand / Server</label>
              <input type="text" name="app_name" value="<%= settings.app_name || 'Juragan Pulsa' %>" required class="input-fintech w-full" />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">URL Server / Domain (Untuk QR APK & WA)</label>
              <input type="text" name="app_url" value="<%= settings.app_url || '' %>" placeholder="http://192.168.1.100:5000 atau https://pulsa.domain.com" class="input-fintech w-full font-mono text-xs" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">No. WhatsApp CS / Bantuan</label>
              <input type="text" name="app_phone" value="<%= settings.app_phone || '' %>" placeholder="081234567890" class="input-fintech w-full font-mono" />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Default Margin Pulsa (Rp)</label>
              <input type="number" name="digiflazz_markup" value="<%= settings.digiflazz_markup || '2000' %>" class="input-fintech w-full font-mono" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Alamat / Informasi Tambahan</label>
            <textarea name="app_address" rows="2" class="input-fintech w-full h-auto py-2"><%= settings.app_address || '' %></textarea>
          </div>

          <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
            <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-3">Kredensial Digiflazz H2H</h4>

            <div class="space-y-3.5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Username Digiflazz</label>
                  <input type="text" name="digiflazz_username" value="<%= settings.digiflazz_username || '' %>" placeholder="username" class="input-fintech w-full font-mono" />
                </div>

                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">API Key Digiflazz</label>
                  <input type="password" name="digiflazz_api_key" value="<%= settings.digiflazz_api_key || '' %>" placeholder="dev-xxxx / prod-xxxx" class="input-fintech w-full font-mono" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Webhook Secret Digiflazz (HMAC-SHA1)</label>
                <input type="password" name="digiflazz_webhook_secret" value="<%= settings.digiflazz_webhook_secret || '' %>" placeholder="Secret string" class="input-fintech w-full font-mono" />
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-3.5">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Integrasi QRIS Statis to Dynamic</h4>
                <p class="text-[11px] text-slate-400">Konversi QRIS Statis merchant (DANA/BCA/Bank) menjadi QRIS Dinamis ber-nominal unik otomatis.</p>
              </div>
              <div>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="qris_static_enabled" value="1" <%= (settings.qris_static_enabled === '1' || settings.qris_static_enabled === 1 || settings.qris_static_enabled === true || settings.qris_static_enabled === 'true') ? 'checked' : '' %> class="checkbox checkbox-xs rounded checkbox-primary" />
                  <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Aktifkan QRIS</span>
                </label>
              </div>
            </div>

            <input type="hidden" name="qris_image_path" id="qris_image_path_input" value="<%= settings.qris_image_path || '' %>" />

            <!-- Direct QRIS Image Upload Zone -->
            <div class="space-y-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500">Unggah Gambar / File QRIS Statis</label>
              
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="sm:col-span-2">
                  <label for="qris_file_input" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-slate-300 dark:border-slate-700 hover:border-blue-500 dark:hover:border-blue-500 rounded-xl cursor-pointer bg-slate-50/60 dark:bg-slate-800/40 hover:bg-blue-50/40 dark:hover:bg-blue-900/20 transition-all text-center group">
                    <input type="file" id="qris_file_input" accept="image/*" class="hidden" onchange="handleQrisImageUpload(this)" />
                    <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform mb-2">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">Klik / Tarik Gambar QRIS ke Sini</span>
                    <span class="text-[10px] text-slate-400 mt-0.5">Format: JPG, PNG, WEBP. Payload EMVCo diekstrak otomatis &amp; instan.</span>
                  </label>
                </div>

                <!-- QR Image Preview / Thumbnail Box -->
                <div id="qris_thumb_container" class="p-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200/80 dark:border-slate-700 flex flex-col items-center justify-center text-center">
                  <% if (settings.qris_image_path) { %>
                    <img id="qris_thumb_img" src="<%= settings.qris_image_path %>" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-slate-200 shadow-xs mb-1" />
                    <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">Gambar QRIS Tersimpan</span>
                  <% } else { %>
                    <div id="qris_thumb_placeholder" class="space-y-1">
                      <span class="text-xl">🖼️</span>
                      <p class="text-[10px] text-slate-400">Belum ada gambar QRIS yang diunggah.</p>
                    </div>
                  <% } %>
                </div>
              </div>

              <!-- Upload Decode Status Indicator -->
              <div id="qris_decode_status" style="display: none;" class="p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 text-emerald-700 dark:text-emerald-300 text-xs flex items-center justify-between">
                <span id="qris_decode_status_text">✅ Gambar QRIS berhasil di-scan &amp; payload terisi otomatis!</span>
                <button type="button" onclick="testQrisPreview()" class="font-bold underline text-emerald-800 dark:text-emerald-200">Lihat QR Dinamis</button>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Payload EMVCo QRIS Statis (String)</label>
              <textarea name="qris_static_payload" id="qris_payload_input" rows="3" placeholder="0002010102112657...6304XXXX" class="input-fintech w-full h-auto py-2 font-mono text-[11px]"><%= settings.qris_static_payload || '' %></textarea>
              <div class="flex items-center justify-between mt-1.5">
                <span class="text-[10px] text-slate-400">Payload string EMVCo (dihasilkan otomatis saat upload gambar atau disalin manual).</span>
                <button type="button" onclick="testQrisPreview()" class="text-xs font-semibold text-blue-600 hover:text-blue-700 flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  <span>Uji Generate Dynamic QRIS</span>
                </button>
              </div>
            </div>
          </div>


          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-3.5">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Pembaruan Aplikasi Android (In-App Auto Update)</h4>
                <p class="text-[11px] text-slate-400">Konfigurasi versi APK terbaru agar agen dapat mengunduh dan memasang update otomatis dari server.</p>
              </div>
              <div>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" name="app_force_update" value="1" <%= (settings.app_force_update === '1' || settings.app_force_update === 1 || settings.app_force_update === true) ? 'checked' : '' %> class="checkbox checkbox-xs rounded checkbox-primary" />
                  <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Wajibkan Update</span>
                </label>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Version Code (Build)</label>
                <input type="number" name="app_version_code" value="<%= settings.app_version_code || '1' %>" class="input-fintech w-full font-mono text-xs" />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Version Name (Versi)</label>
                <input type="text" name="app_version_name" value="<%= settings.app_version_name || '1.0.0' %>" placeholder="1.0.0" class="input-fintech w-full font-mono text-xs" />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">File Path / URL Download</label>
                <input type="text" name="app_download_url" value="<%= settings.app_download_url || '/downloads/juragan-pulsa.apk' %>" class="input-fintech w-full font-mono text-xs" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Catatan Rilis (Release Notes)</label>
              <textarea name="app_release_notes" rows="2" placeholder="• Fitur baru...&#10;• Perbaikan bug..." class="input-fintech w-full h-auto py-2 text-xs"><%= settings.app_release_notes || '• Fitur Scan QR Code Akun & WhatsApp Bot Onboarding\n• Cetak struk kasir Bluetooth Thermal Printer 58mm/80mm\n• Pembaruan aplikasi otomatis dari server\n• Gateway verifikasi deposit otomatis pengganti MacroDroid' %></textarea>
              <p class="text-[10px] text-slate-400 mt-1">Letakkan file APK rilis di folder server: <code>public/downloads/juragan-pulsa.apk</code>.</p>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-100 dark:border-slate-800 space-y-3.5">
            <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500 mb-2">WhatsApp Bot & Akses Admin</h4>

            <div>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="whatsapp_enabled" value="1" <%= (settings.whatsapp_enabled === '1' || settings.whatsapp_enabled === 1 || settings.whatsapp_enabled === true) ? 'checked' : '' %> class="checkbox checkbox-xs rounded checkbox-primary" />
                <span class="text-xs font-semibold text-slate-700 dark:text-slate-300">Aktifkan Notifikasi & Transaksi Bot WhatsApp (Baileys)</span>
              </label>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">Nomor WhatsApp Administrator (Koma terpisah)</label>
              <input type="text" name="whatsapp_admin_numbers" value="<%= settings.whatsapp_admin_numbers || '' %>" placeholder="081234567890, 08987654321" class="input-fintech w-full font-mono text-xs" />
              <p class="text-[10px] text-slate-400 mt-1">Nomor HP yang memiliki hak akses menjalankan perintah admin via WhatsApp (contoh: <code>topup</code>, <code>saldodigi</code>, <code>appdeposit</code>).</p>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-end">
            <button type="submit" class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-0 text-xs font-semibold">Simpan Pengaturan</button>
          </div>

        </form>
      </div>

      <!-- QRIS Test Preview Box (Hidden by default, shown on test click) -->
      <div id="qris-preview-modal" style="display: none;" class="bg-white dark:bg-slate-900 rounded-2xl border border-blue-200 dark:border-blue-900/50 p-5 shadow-sm space-y-3 animate-fade-in">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
          <div class="flex items-center gap-2">
            <span class="badge-status badge-status-success">Preview QRIS Dinamis</span>
            <span class="text-xs font-bold text-slate-800 dark:text-slate-100" id="qris-preview-nominal">Rp 50.125</span>
          </div>
          <button type="button" onclick="document.getElementById('qris-preview-modal').style.display='none'" class="text-slate-400 hover:text-slate-600 text-xs font-bold">&times; Tutup</button>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div id="qris-preview-img-box" class="p-2 bg-white rounded-xl border border-slate-200 shrink-0">
            <!-- Dynamic QR Image -->
          </div>
          <div class="space-y-1.5 text-xs">
            <p class="text-slate-600 dark:text-slate-300 font-medium">✅ QRIS Dinamis Berhasil Dihasilkan!</p>
            <p class="text-[11px] text-slate-500">Payload dynamic:</p>
            <div class="p-2 bg-slate-50 dark:bg-slate-800/60 rounded border border-slate-200 dark:border-slate-700 font-mono text-[10px] break-all max-h-20 overflow-y-auto" id="qris-preview-payload"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Sidebar (Password & WhatsApp Status) -->
    <div class="space-y-5">
      
      <!-- WhatsApp Baileys Bot Card -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">WhatsApp Gateway (Baileys)</h4>
          <span id="wa-poll-indicator" class="text-[10px] text-slate-400 font-mono">Live Polling</span>
        </div>
        
        <!-- Status Indicator Box -->
        <div id="wa-status-box" class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/80 dark:border-slate-800 flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-600 dark:text-slate-300">Status Bot:</span>
            <p id="wa-status-detail" class="text-[11px] text-slate-400 mt-0.5">Mengecek koneksi...</p>
          </div>
          <div id="wa-status-badge">
            <span class="badge-status badge-status-pending">
              <span class="dot-pulse dot-pulse-pending"></span> Mengecek...
            </span>
          </div>
        </div>

        <!-- Live QR Code Container (Auto-updates via polling) -->
        <div id="wa-qr-section" style="display: none;" class="p-4 bg-white dark:bg-slate-950 rounded-xl border border-slate-200 dark:border-slate-800 text-center space-y-2.5 shadow-sm">
          <div class="flex items-center justify-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-200">
            <svg class="w-4 h-4 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
            <span>Pindai QR Code WhatsApp</span>
          </div>
          <p class="text-[11px] text-slate-500">Buka WhatsApp &rarr; <b>Perangkat Tertaut</b> &rarr; <b>Tautkan Perangkat</b></p>
          <div id="wa-qr-img-wrapper" class="flex justify-center p-2 bg-white rounded-lg inline-block mx-auto border border-slate-200">
            <!-- Dynamic QR Image Injected Here -->
            <div class="w-48 h-48 flex items-center justify-center text-xs text-slate-400">
              Menyiapkan QR Code...
            </div>
          </div>
          <p class="text-[10px] text-slate-400 font-mono">QR Code akan diperbarui secara otomatis.</p>
        </div>

        <!-- Connected Info Section -->
        <div id="wa-info-section" style="display: none;" class="p-3 bg-emerald-50/70 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-900/40 rounded-xl text-xs space-y-1">
          <div class="flex items-center gap-1.5 font-bold text-emerald-800 dark:text-emerald-300">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>WhatsApp Bot Aktif</span>
          </div>
          <p class="text-slate-600 dark:text-slate-300 text-[11px]">Akun Terhubung: <strong id="wa-user-phone" class="font-mono text-slate-900 dark:text-white">-</strong></p>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-2 pt-1">
          <form action="/admin/settings/whatsapp/start" method="POST">
            <button type="submit" class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-0 w-full text-xs font-semibold gap-1.5 shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              <span>Hubungkan / Generate QR Baru</span>
            </button>
          </form>

          <form action="/admin/settings/whatsapp/test" method="POST">
            <button type="submit" class="btn btn-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 w-full text-xs font-semibold gap-1.5 shadow-sm">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
              <span>Kirim Test Notifikasi WA</span>
            </button>
          </form>

          <form action="/admin/settings/whatsapp/reset" method="POST" onsubmit="return confirm('Hapus sesi WhatsApp dan reset pairing? Anda harus scan QR ulang setelah ini.')">
            <button type="submit" class="btn btn-sm btn-ghost text-red-500 hover:bg-red-50 w-full text-xs font-semibold gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              <span>Reset Sesi / Hapus Auth</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Change Admin Password Card -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-sm space-y-4">
        <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Ganti Password Administrator</h4>
        
        <form action="/admin/settings/password" method="POST" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Password Lama</label>
            <input type="password" name="old_password" required class="input-fintech w-full" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Password Baru</label>
            <input type="password" name="new_password" required class="input-fintech w-full" placeholder="Minimal 6 karakter" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Konfirmasi Password</label>
            <input type="password" name="confirm_password" required class="input-fintech w-full" />
          </div>

          <button type="submit" class="btn btn-sm bg-slate-900 hover:bg-slate-800 text-white border-0 w-full text-xs font-semibold mt-2">
            Perbarui Password
          </button>
        </form>
      </div>

      <!-- WhatsApp Bot Command Cheatsheet Card -->
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-500">Panduan Perintah Bot WA</h4>
          <span class="badge-status badge-status-success">Bot 24 Jam</span>
        </div>
        
        <div class="space-y-3 text-xs">
          <!-- Admin Commands -->
          <div>
