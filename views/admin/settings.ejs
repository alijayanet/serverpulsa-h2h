<!-- jsQR for client-side QRIS image parsing -->
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>

<!-- Realtime WhatsApp Polling & QRIS Preview & Image Upload Script -->
<script>
  let lastWaQr = '';

  // Handle Client-side QRIS Image Upload & EMVCo Decoding
  async function handleQrisImageUpload(input) {
    if (!input.files || !input.files[0]) return;
    const file = input.files[0];

    const statusBox = document.getElementById('qris_decode_status');
    const statusText = document.getElementById('qris_decode_status_text');
    const thumbContainer = document.getElementById('qris_thumb_container');

    statusBox.style.display = 'flex';
    statusText.innerText = '🔍 Membaca & memproses gambar QRIS...';

    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = async function() {
        // Try decoding with original and scaled sizes if needed
        let decodedPayload = decodeQrFromImage(img);

        if (!decodedPayload) {
          // Retry with resized canvas for high-resolution camera photos
          decodedPayload = decodeQrFromImageResized(img, 1000);
        }

        if (decodedPayload) {
          document.getElementById('qris_payload_input').value = decodedPayload;
          statusBox.className = 'p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900/50 text-emerald-700 dark:text-emerald-300 text-xs flex items-center justify-between';
          statusText.innerText = '✅ Payload EMVCo QRIS berhasil diekstrak & diisi otomatis!';
          
          // Update preview thumbnail
          thumbContainer.innerHTML = `
            <img src="${e.target.result}" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-slate-200 shadow-xs mb-1" />
            <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">QRIS Terdeteksi</span>
          `;

          // Upload image to server for persistent storage
          uploadQrisImageToServer(file);

          // Automatically test and preview dynamic QRIS
          setTimeout(() => testQrisPreview(), 300);
        } else {
          statusBox.className = 'p-2.5 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900/50 text-amber-700 dark:text-amber-300 text-xs flex items-center justify-between';
          statusText.innerText = '⚠️ QR Code tidak terdeteksi jelas pada gambar. Pastikan gambar tidak blur atau isi teks payload manual.';
          
          thumbContainer.innerHTML = `
            <img src="${e.target.result}" alt="QRIS Merchant" class="w-20 h-20 object-contain rounded-lg border border-amber-200 shadow-xs mb-1" />
            <span class="text-[10px] font-medium text-amber-600 dark:text-amber-400">Cek Manual</span>
          `;
        }
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  function decodeQrFromImage(img) {
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = img.width;
    canvas.height = img.height;
    ctx.drawImage(img, 0, 0, img.width, img.height);
    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const code = jsQR(imageData.data, imageData.width, imageData.height, {
      inversionAttempts: 'attemptBoth'
    });
    return code ? code.data : null;
  }

  function decodeQrFromImageResized(img, maxDimension) {
    let width = img.width;
    let height = img.height;
    if (width > maxDimension || height > maxDimension) {
      if (width > height) {
        height = Math.round((height * maxDimension) / width);
        width = maxDimension;
      } else {
        width = Math.round((width * maxDimension) / height);
        height = maxDimension;
      }
    }
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    canvas.width = width;
    canvas.height = height;
    ctx.drawImage(img, 0, 0, width, height);
    const imageData = ctx.getImageData(0, 0, width, height);
    const code = jsQR(imageData.data, imageData.width, imageData.height, {
      inversionAttempts: 'attemptBoth'
    });
    return code ? code.data : null;
  }

  async function uploadQrisImageToServer(file) {
    try {
      const formData = new FormData();
      formData.append('qris_image', file);

      const res = await fetch('/admin/settings/qris/upload', {
        method: 'POST',
        body: formData
      });

      const data = await res.json();
      if (data.success && data.filePath) {
        document.getElementById('qris_image_path_input').value = data.filePath;
      }
    } catch (e) {
      console.warn('[QRIS Upload] Background upload notice:', e.message);
    }
  }

  async function pollWhatsAppStatus() {
    try {
      const res = await fetch('/admin/settings/whatsapp/status');
      if (!res.ok) return;
      const data = await res.json();
      
      const badgeEl = document.getElementById('wa-status-badge');
      const detailEl = document.getElementById('wa-status-detail');
      const qrSection = document.getElementById('wa-qr-section');
      const qrWrapper = document.getElementById('wa-qr-img-wrapper');
      const infoSection = document.getElementById('wa-info-section');
      const userPhone = document.getElementById('wa-user-phone');

      const conn = data.connection || data.status;

      if (conn === 'open') {
        badgeEl.innerHTML = '<span class="badge-status badge-status-success"><span class="dot-pulse dot-pulse-success"></span> Terhubung</span>';
        detailEl.innerText = 'Bot aktif & siap memproses transaksi via WhatsApp';
        qrSection.style.display = 'none';
        infoSection.style.display = 'block';
        if (data.user && data.user.id) {
          const phone = data.user.id.split(':')[0];
          userPhone.innerText = '+' + phone + (data.user.name ? ' (' + data.user.name + ')' : '');
        } else {
          userPhone.innerText = 'Bot Online';
        }
      } else if (conn === 'qr') {
        badgeEl.innerHTML = '<span class="badge-status badge-status-pending"><span class="dot-pulse dot-pulse-pending"></span> Perlu Scan QR</span>';
        detailEl.innerText = 'Silakan scan QR Code dengan WhatsApp Anda';
        qrSection.style.display = 'block';
        infoSection.style.display = 'none';

        if (data.qrImage && data.qr !== lastWaQr) {
          lastWaQr = data.qr;
          qrWrapper.innerHTML = `<img src="${data.qrImage}" alt="Scan WhatsApp QR" class="w-48 h-48 rounded-lg shadow-xs" />`;
        }
      } else if (conn === 'connecting') {
        badgeEl.innerHTML = '<span class="badge-status badge-status-pending"><span class="dot-pulse dot-pulse-pending"></span> Menghubungkan...</span>';
        detailEl.innerText = 'Sedang menyinkronkan koneksi WhatsApp...';
        qrSection.style.display = 'none';
        infoSection.style.display = 'none';
      } else {
        badgeEl.innerHTML = '<span class="badge-status badge-status-failed"><span class="dot-pulse dot-pulse-failed"></span> Terputus</span>';
        detailEl.innerText = 'Bot offline. Klik Hubungkan untuk scan QR';
        qrSection.style.display = 'none';
        infoSection.style.display = 'none';
      }
    } catch (e) {
      console.error('[WA Polling] Error:', e);
    }
  }

  // Poll immediately and every 3 seconds
  pollWhatsAppStatus();
  setInterval(pollWhatsAppStatus, 3000);

  // Test Generate QRIS Preview
  async function testQrisPreview() {
    const payload = document.getElementById('qris_payload_input').value.trim();
    if (!payload) {
      alert('Silakan isi string Payload QRIS Statis atau unggah gambar QRIS terlebih dahulu!');
      return;
    }

    try {
      const res = await fetch('/admin/settings/qris/preview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ payload, amount: 50125 })
      });

      const data = await res.json();
      if (!data.success) {
        alert('Gagal menghasilkan QRIS: ' + (data.error || 'Payload tidak valid'));
        return;
      }

      document.getElementById('qris-preview-nominal').innerText = 'Rp ' + Number(data.amount).toLocaleString('id-ID');
      document.getElementById('qris-preview-img-box').innerHTML = `<img src="${data.dataUrl}" alt="Preview Dynamic QRIS" class="w-40 h-40 rounded-lg shadow-xs" />`;
      document.getElementById('qris-preview-payload').innerText = data.dynamicPayload;
      document.getElementById('qris-preview-modal').style.display = 'block';
      document.getElementById('qris-preview-modal').scrollIntoView({ behavior: 'smooth' });
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }
</script>

